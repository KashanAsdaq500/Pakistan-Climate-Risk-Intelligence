# Application Configuration
APP_NAME="Pakistan Climate Risk Intelligence API"
APP_VERSION="1.0.0"
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database (Default: local SQLite database, PostgreSQL-ready)
# For SQLite: sqlite:///./climate_intelligence.db
# For PostgreSQL: postgresql://user:password@localhost:5432/climate_risk_db
DATABASE_URL=sqlite:///./climate_intelligence.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Optional external LLM key for enhanced answer synthesis (falls back seamlessly to local extractive retrieval if not provided)
OPENAI_API_KEY=
GEMINI_API_KEY=
